<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinemamanage.client.AddBookingViewController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label text="Phone Number:"/>
    <TextField fx:id="phoneNumberField"/>
    <GridPane fx:id="hallLayoutGrid" hgap="5" vgap="5">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
    </GridPane>
    <Button fx:id="bookButton" text="Book" onAction="#onBookButtonClick"/>
</VBox>
