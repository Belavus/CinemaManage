<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="800" prefWidth="1000" xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.2-ea"
            fx:controller="com.cinemamanage.client.controllers.HallsViewController" stylesheets="@../css/styles.css">
    <top>
        <VBox spacing="10">
            <HBox spacing="10">
                <Label text="Choose Hall: "/>
                <ComboBox fx:id="hallsComboBox" onAction="#onHallSelected"/>
                <Button onAction="#onDeleteHallButtonClick" text="Delete Hall"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Rows:"/>
                <TextField fx:id="rowsField"/>
                <Label text="Columns:"/>
                <TextField fx:id="columnsField"/>
                <Label text="Hall Number:"/>
                <TextField fx:id="hallNumberField"/>
                <Button onAction="#onCreateNewHallButtonClick" text="Create New Hall"/>
                <Button onAction="#onSaveNewHallButtonClick" text="Save"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="10">
            <GridPane fx:id="hallLayoutGrid" hgap="5" vgap="5">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10"/>
                </padding>
            </GridPane>
            <VBox spacing="10">
                <Label text="Legend:">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>
                </Label>
                <HBox spacing="5">
                    <Rectangle fill="WHITE" height="20" width="20"/>
                    <Label text="Empty"/>
                </HBox>
                <HBox spacing="5">
                    <Rectangle fill="RED" height="20" width="20"/>
                    <Label text="Occupied"/>
                </HBox>
                <HBox spacing="5">
                    <Rectangle fill="BLACK" height="20" width="20"/>
                    <Label text="Empty Space"/>
                </HBox>
                <HBox spacing="5">
                    <Rectangle fill="BLUE" height="20" width="20"/>
                    <Label text="VIP"/>
                </HBox>
                <HBox spacing="5">
                    <Rectangle fill="YELLOW" height="20" width="20"/>
                    <Label text="Accessible"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
    <bottom>
        <Button onAction="#onBackButtonClick" text="Back"/>
    </bottom>
</BorderPane>