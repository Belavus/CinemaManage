<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.cinemamanage.client.HallsViewController">
    <top>
        <VBox spacing="10">
            <HBox spacing="10">
                <ComboBox fx:id="hallsComboBox" onAction="#onHallSelected"/>
                <Button text="Get All Halls" onAction="#onGetAllHallsButtonClick"/>
                <Button text="New Hall" onAction="#onNewHallButtonClick"/>
            </HBox>
            <HBox spacing="10">
                <Label text="Rows:"/>
                <TextField fx:id="rowsField"/>
                <Label text="Columns:"/>
                <TextField fx:id="columnsField"/>
                <Label text="Hall Number:"/>
                <TextField fx:id="hallNumberField"/>
                <Button text="Create" onAction="#onCreateNewHallButtonClick"/>
                <Button text="Save" onAction="#onSaveNewHallButtonClick"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <GridPane fx:id="hallLayoutGrid" hgap="5" vgap="5">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </GridPane>
    </center>
</BorderPane>
