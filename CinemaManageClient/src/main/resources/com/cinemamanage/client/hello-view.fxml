<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.cinemamanage.client.MainViewController">
  <Label fx:id="welcomeText" text="Welcome to Cinema Manage Client!" />
  <TextField fx:id="inputField" promptText="Enter your request" />
  <Button text="Send" onAction="#onSendButtonClick" />
  <Button fx:id="getAllHallsButton" text="Get All Halls" onAction="#onGetAllHallsButtonClick" />
  <ListView fx:id="hallsListView" />
</VBox>
