<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.cinemamanage.client.controllers.MainViewController"
           prefWidth="800" prefHeight="600"
           fx:id="mainPane">
  <VBox fx:id="mainContent" alignment="CENTER" spacing="20.0">
    <Button text="Halls" onAction="#onHallsButtonClick"/>
    <Button text="Sessions" onAction="#onSessionsButtonClick"/>
    <Button text="Bookings" onAction="#onBookingsButtonClick"/>
  </VBox>
</StackPane>



